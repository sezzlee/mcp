{
  "name": "@sezzlee/sdk-nestjs",
  "version": "0.2.0",
  "description": "Embeds an MCP layer into an existing NestJS backend: search-first tool discovery over your real endpoints, dispatched through your own guards, pipes and interceptors.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nestjs",
    "sezzlee",
    "agents",
    "ai",
    "llm",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sezzlee/mcp.git",
    "directory": "sdks/nestjs"
  },
  "homepage": "https://github.com/sezzlee/mcp/tree/main/sdks/nestjs#readme",
  "bugs": {
    "url": "https://github.com/sezzlee/mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sezzlee/core": "workspace:^"
  },
  "peerDependencies": {
    "@modelcontextprotocol/express": ">=2.0.0",
    "@modelcontextprotocol/node": ">=2.0.0",
    "@modelcontextprotocol/server": ">=2.0.0",
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "@types/express": ">=4",
    "class-transformer": ">=0.5",
    "class-validator": ">=0.14",
    "rxjs": "^7.1.0",
    "zod": "^4.5.4"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/testing": "^11.1.6",
    "@sezzlee/oxlint-config": "workspace:*",
    "@sezzlee/typescript-config": "workspace:*",
    "@swc/core": "^1.13.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.2.1",
    "hono": "^4.11.4",
    "jsonwebtoken": "^9.0.2",
    "oxlint": "1.85.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "7.0.2",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.4"
  }
}
