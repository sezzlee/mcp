{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "invoke-result.schema.json",
  "title": "InvokeResult",
  "oneOf": [
    {
      "$ref": "#/$defs/InvokeSuccess"
    },
    {
      "$ref": "#/$defs/MappedError"
    },
    {
      "$ref": "#/$defs/SdkError"
    }
  ],
  "$defs": {
    "BackendErrorCode": {
      "title": "BackendErrorCode",
      "type": "string",
      "enum": [
        "validation_failed",
        "bad_request",
        "unauthenticated",
        "forbidden",
        "not_found",
        "conflict",
        "rate_limited",
        "backend_error",
        "backend_unavailable"
      ]
    },
    "FieldError": {
      "title": "FieldError",
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "MappedError": {
      "title": "MappedError",
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "message", "status", "retryable"],
      "properties": {
        "error": {
          "$ref": "#/$defs/BackendErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "retryable": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "InvokeSuccess": {
      "title": "InvokeSuccess",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 399
        },
        "body": {},
        "contentType": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SdkErrorCode": {
      "title": "SdkErrorCode",
      "type": "string",
      "enum": [
        "unknown_tool",
        "not_invocable",
        "unknown_argument",
        "invalid_path_type",
        "missing_path_parameter",
        "header_injection",
        "null_not_allowed",
        "invalid_type",
        "deferred_value_missing",
        "deferred_value_invalid",
        "invalid_cookie_value",
        "cookie_carrier_collision",
        "invalid_file_argument",
        "file_too_large",
        "file_unresolved",
        "response_too_large",
        "invoke_timeout",
        "search_ranker_unavailable",
        "internal_error",
        "tool_changed"
      ]
    },
    "PayloadShapeKind": {
      "title": "PayloadShapeKind",
      "type": "string",
      "enum": ["array", "object", "text"]
    },
    "PayloadShape": {
      "title": "PayloadShape",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/PayloadShapeKind"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PayloadFacts": {
      "title": "PayloadFacts",
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "limit", "shape"],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "shape": {
          "$ref": "#/$defs/PayloadShape"
        }
      }
    },
    "SdkError": {
      "title": "SdkError",
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "message", "retryable"],
      "properties": {
        "error": {
          "$ref": "#/$defs/SdkErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        },
        "payload": {
          "$ref": "#/$defs/PayloadFacts"
        }
      }
    }
  }
}
