{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openapi-extension.schema.json",
  "title": "OpenApiExtension",
  "description": "The value of an x-sezzlee extension. An operation carries an OperationExtension; a path item or the document root carries a ScopeExtension. A gateway config's operations entry is an OperationExtension too, laid over the document's field by field.",
  "anyOf": [
    {
      "$ref": "#/$defs/OperationExtension"
    },
    {
      "$ref": "#/$defs/ScopeExtension"
    }
  ],
  "$defs": {
    "OperationExtension": {
      "title": "OperationExtension",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "boolean",
          "description": "Operation-level selection marker: true includes the operation, false excludes it. It outranks every config selection rule."
        },
        "foldedInto": {
          "type": "string",
          "pattern": "^[A-Z]+ /",
          "description": "Another route of an operation published from a different one, named as METHOD /path the way the document writes it. The route is indexed as that operation's alternate route; it is never invoked."
        },
        "toolName": {
          "$ref": "endpoint-descriptor.schema.json#/properties/toolName"
        },
        "containerPrefix": {
          "$ref": "endpoint-descriptor.schema.json#/properties/containerPrefix"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Replaces the description the operation's summary and description would give its tool."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Replaces the operation's tags as the tool's search tags; its naming container still comes from the operation's first tag."
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParameterSchema"
          },
          "description": "Replaces the schema, requiredness and description of the operation's parameters, matched by name and location. The wire form stays the document's; when the two do not name the same parameters, the document's are kept and extension_schema_mismatch is reported."
        },
        "requestBody": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/VariantRequestBody"
        },
        "responses": {
          "$ref": "endpoint-descriptor.schema.json#/properties/responses"
        },
        "publishedSchemas": {
          "type": "boolean",
          "description": "Every schema this extension carries (parameters, requestBody, responses, and the request bodies of variants and family members) is JSON Schema 2020-12 as an SDK published it, self-contained, and is taken as written rather than normalized as a Schema Object of the document."
        },
        "annotations": {
          "$ref": "tool-definition.schema.json#/$defs/ToolAnnotations"
        },
        "anonymous": {
          "const": true,
          "description": "Any caller may make the call, with or without credentials, and no policy narrows it. The only visibility a document carries; it changes no credential the call is sent with."
        },
        "arguments": {
          "$ref": "endpoint-descriptor.schema.json#/properties/arguments"
        },
        "variants": {
          "$ref": "endpoint-descriptor.schema.json#/properties/variants"
        },
        "family": {
          "$ref": "#/$defs/FamilyDeclaration"
        },
        "searchTerms": {
          "$ref": "endpoint-descriptor.schema.json#/properties/searchTerms"
        },
        "revision": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/Revision/properties/operation"
        }
      }
    },
    "ScopeExtension": {
      "title": "ScopeExtension",
      "type": "object",
      "additionalProperties": false,
      "required": ["revision"],
      "properties": {
        "revision": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/Revision/properties/operation"
        }
      }
    },
    "ParameterSchema": {
      "title": "ParameterSchema",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "in", "required", "schema"],
      "properties": {
        "name": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/Parameter/properties/name"
        },
        "in": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/Parameter/properties/in"
        },
        "required": {
          "type": "boolean"
        },
        "schema": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/JsonSchemaObject"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "FamilyDeclaration": {
      "title": "FamilyDeclaration",
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "members"],
      "properties": {
        "parameter": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/ToolFamily/properties/parameter"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FamilyMember"
          }
        }
      }
    },
    "FamilyMember": {
      "title": "FamilyMember",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "description"],
      "description": "A ToolVariant plus the key it dispatches to. The key becomes a hidden constant on the family's parameter, so a member cannot be written without one.",
      "properties": {
        "key": {
          "$ref": "#/$defs/FamilyKey"
        },
        "name": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/ToolVariant/properties/name"
        },
        "description": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/ToolVariant/properties/description"
        },
        "arguments": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/ToolVariant/properties/arguments"
        },
        "requestBody": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/VariantRequestBody"
        },
        "annotations": {
          "$ref": "tool-definition.schema.json#/$defs/ToolAnnotations"
        }
      }
    },
    "FamilyKey": {
      "title": "FamilyKey",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer"
        }
      ]
    }
  }
}
