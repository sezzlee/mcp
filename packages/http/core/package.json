{
  "name": "@sezzlee/core",
  "version": "0.2.0",
  "description": "TypeScript reference implementation of sezzlee's HTTP catalog spec: naming, selection, curation, search, request composition and error mapping.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sezzlee",
    "tool-catalog",
    "openapi",
    "agents",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sezzlee/mcp.git",
    "directory": "packages/http/core"
  },
  "homepage": "https://github.com/sezzlee/mcp/tree/main/packages/http/core#readme",
  "bugs": {
    "url": "https://github.com/sezzlee/mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen": "node scripts/generate-types.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "bench:search": "pnpm run build && node --expose-gc bench/search.mjs",
    "dev": "tsc --watch",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.1",
    "@sezzlee/oxlint-config": "workspace:*",
    "@sezzlee/spec": "workspace:*",
    "@sezzlee/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "1.85.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
