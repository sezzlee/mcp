{
  "kind": "result-reading",
  "description": "'-' names the element after the last one, which does not exist in a stored result.",
  "input": {
    "body": {
      "total": 3,
      "items": [
        {
          "id": 1,
          "status": "open"
        },
        {
          "id": 2,
          "status": "paid",
          "note": "gift"
        },
        {
          "id": 3
        }
      ],
      "meta": {
        "page": {
          "size": 3
        }
      }
    },
    "read": {
      "path": "/items/-"
    }
  },
  "expected": {
    "error": "invalid_selection",
    "message": "Path '/items/-' names nothing in the stored result. The longest part of it that exists is '/items'.",
    "retryable": false
  }
}
