              "type": "string"
            }
          }
        }
      },
      {
        "name": "get_customer_by_id",
        "description": "Müşteri kaydını getirir.",
        "route": "/Rest/Customers/{id}",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            }
          }
        }
      }
    ],
    "query": "dynamic bakiye"
  },
  "expected": {
    "names": [
      "list_customer_balances",
      "list_delayed_orders",
      "assign_courier"
    ]
