{
  "kind": "search",
  "description": "Every member carries the dispatcher's route, so a route term matches all of them with a low idf; a member's own description term still decides which one ranks first",
  "input": {
    "tools": [
      {
        "name": "list_customer_balances",
        "description": "Müşteri bakiyelerini listeler.",
        "route": "/Rest/InvokeDynamicMethod/{methodId}",
        "inputSchema": {
          "type": "object",
          "properties": {
            "minBalance": {
              "type": "number",
              "description": "En düşük bakiye."
            }
          }
        }
      },
      {
        "name": "list_delayed_orders",
        "description": "Gecikmiş siparişleri listeler.",
        "route": "/Rest/InvokeDynamicMethod/{methodId}",
        "inputSchema": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer"
            }
          }
        }
      },
      {
        "name": "assign_courier",
        "description": "Siparişe kurye atar.",
        "route": "/Rest/InvokeDynamicMethod/{methodId}",
        "inputSchema": {
          "type": "object",
          "properties": {
            "orderNumber": {
              "type": "string"
            },
            "courierCode": {
              "type": "string"
            },
            "vehiclePlate": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "list_orders",
