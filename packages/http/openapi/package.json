{
  "name": "@sezzlee/openapi",
  "version": "0.2.0",
  "description": "Ingests a Swagger 2.0 or OpenAPI 3.0–3.2 document into the endpoint descriptors the sezzlee catalog is built from.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sezzlee",
    "openapi",
    "swagger",
    "agents",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sezzlee/mcp.git",
    "directory": "packages/http/openapi"
  },
  "homepage": "https://github.com/sezzlee/mcp/tree/main/packages/http/openapi#readme",
  "bugs": {
    "url": "https://github.com/sezzlee/mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sezzlee/core": "workspace:^",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@sezzlee/oxlint-config": "workspace:*",
    "@sezzlee/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
