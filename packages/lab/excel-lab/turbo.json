{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "corpus": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["SEZZLEE_CORPUS"]
    },
    "result-scenario": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "cache": false
    },
    "agent": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "SEZZLEE_CORPUS",
        "SEZZLEE_AGENT_LAB_OLLAMA_URL",
        "SEZZLEE_AGENT_LAB_OLLAMA_KEY"
      ]
    }
  }
}
