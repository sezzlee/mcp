{
  "name": "@sezzlee/xml-mcp",
  "version": "0.5.1",
  "mcpName": "io.github.sezzlee/xml",
  "description": "Read-only MCP server that lets AI agents query local XML documents with XPath, paged and sandboxed to one folder.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "claude",
    "sezzlee",
    "xml",
    "xpath",
    "xml-query",
    "libxml2",
    "read-only",
    "sandbox"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sezzlee/mcp.git",
    "directory": "packages/servers/xml-mcp"
  },
  "homepage": "https://github.com/sezzlee/mcp/tree/main/packages/servers/xml-mcp#readme",
  "bugs": {
    "url": "https://github.com/sezzlee/mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sezzlee-xml": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@sezzlee/file-core": "workspace:^",
    "libxml2-wasm": "0.7.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@sezzlee/oxlint-config": "workspace:*",
    "@sezzlee/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
