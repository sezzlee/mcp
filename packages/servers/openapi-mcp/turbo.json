{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "!test/**", "!vitest.config.ts"]
    },
    "test": {
      "dependsOn": ["build"],
      "passThroughEnv": [
        "SEZZLEE_OPENAPI_CONFIG",
        "SEZZLEE_OPENAPI_ACCEPTANCE_DOC"
      ]
    },
    "dev": {
      "passThroughEnv": ["SEZZLEE_OPENAPI_CONFIG"]
    }
  }
}
