{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sezzlee/openapi",
  "title": "Sezzlee OpenAPI",
  "description": "Expose an OpenAPI document to agents as a search-first tool catalog over your existing API.",
  "websiteUrl": "https://docs.sezzlee.app/docs/http-catalog/quickstart",
  "repository": {
    "url": "https://github.com/sezzlee/mcp",
    "source": "github",
    "subfolder": "packages/servers/openapi-mcp"
  },
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@sezzlee/openapi-mcp",
      "version": "0.2.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SEZZLEE_OPENAPI_CONFIG",
          "description": "Path to the server config file",
          "isRequired": true,
          "format": "filepath"
        }
      ]
    }
  ]
}
