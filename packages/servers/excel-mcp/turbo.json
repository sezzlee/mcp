{
  "extends": ["//"],
  "tasks": {
    "build": { "inputs": ["$TURBO_DEFAULT$", "!test/**", "!vitest.config.ts"] },
    "test": {
      "dependsOn": ["build"],
      "env": [
        "SEZZLEE_CORPUS",
        "SEZZLEE_TYPED_FUZZ_SEED",
        "SEZZLEE_CALCULATION_ORACLE",
        "TZ"
      ]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "env": ["SEZZLEE_TYPED_FUZZ_SEED"],
      "outputs": ["coverage/**"]
    }
  }
}
