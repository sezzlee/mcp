{
  "name": "@sezzlee/excel-mcp",
  "version": "0.8.0",
  "mcpName": "io.github.sezzlee/excel",
  "description": "Read-only MCP server that lets AI agents read local Excel workbooks (.xlsx, .xlsm, .csv): cells, formulas, tables and defined names, sandboxed to one folder.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "claude",
    "sezzlee",
    "excel",
    "xlsx",
    "xlsm",
    "csv",
    "spreadsheet",
    "workbook",
    "read-only",
    "sandbox"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sezzlee/mcp.git",
    "directory": "packages/servers/excel-mcp"
  },
  "homepage": "https://github.com/sezzlee/mcp/tree/main/packages/servers/excel-mcp#readme",
  "bugs": {
    "url": "https://github.com/sezzlee/mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sezzlee-excel": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@sezzlee/file-core": "workspace:^",
    "@sezzlee/ooxml-core": "workspace:^",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@e965/xlsx": "0.20.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@sezzlee/oxlint-config": "workspace:*",
    "@sezzlee/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "jszip": "3.10.1",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
