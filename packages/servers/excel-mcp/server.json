{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sezzlee/excel",
  "title": "Sezzlee Excel",
  "description": "Read spreadsheets; build immutable reports with bulk preparation, calculation, charts and pivots.",
  "websiteUrl": "https://docs.sezzlee.app/docs/excel-mcp/quickstart",
  "repository": {
    "url": "https://github.com/sezzlee/mcp",
    "source": "github",
    "subfolder": "packages/servers/excel-mcp"
  },
  "version": "0.13.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@sezzlee/excel-mcp",
      "version": "0.13.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "root",
          "description": "Folder the server may read; every path stays inside it",
          "isRequired": true,
          "format": "filepath"
        }
      ]
    }
  ]
}
