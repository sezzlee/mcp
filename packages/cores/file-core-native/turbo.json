{
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": false,
      "passThroughEnv": [
        "SEZZLEE_NODE_HEADERS",
        "SEZZLEE_NODE_LIB",
        "CXX",
        "INCLUDE",
        "LIB",
        "LIBPATH"
      ],
      "outputs": ["prebuilds/**"]
    },
    "test": { "dependsOn": ["build"] },
    "test:output": { "dependsOn": ["build"] },
    "test:security": { "dependsOn": ["build"] }
  }
}
