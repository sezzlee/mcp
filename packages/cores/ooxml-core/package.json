{
  "name": "@sezzlee/ooxml-core",
  "version": "0.3.0",
  "description": "Shared reader for OOXML containers: zip part source, OPC package, relationships, content types, single-pass XML part scanning.",
  "keywords": [
    "ooxml",
    "office-open-xml",
    "ecma-376",
    "opc",
    "zip",
    "sax",
    "xlsx",
    "sezzlee"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sezzlee/mcp.git",
    "directory": "packages/cores/ooxml-core"
  },
  "homepage": "https://github.com/sezzlee/mcp/tree/main/packages/cores/ooxml-core#readme",
  "bugs": {
    "url": "https://github.com/sezzlee/mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@sezzlee/oxlint-config": "workspace:*",
    "@sezzlee/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "jszip": "3.10.1",
    "oxlint": "1.85.0",
    "saxes": "^6.0.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
